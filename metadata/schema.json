{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Luau Torture Test Corpus Index",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": { "type": "string" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["file", "category", "difficulty", "tags", "description"],
      "properties": {
        "file": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["syntax", "luau-specific", "semantic-traps",
                   "formatting-extremes"]
        },
        "difficulty": {
          "type": "string",
          "enum": ["trivial", "easy", "medium", "hard", "pathological"]
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
